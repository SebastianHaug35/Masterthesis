              "operation": "notEmpty",
              "value1": "={{$json.case_id}}"
            },
            {
              "operation": "notEmpty",
              "value1": "={{$json.invoice_number}}"
            },
            {
              "operation": "notEmpty",
              "value1": "={{$json.po_number}}"
            },
            {
              "operation": "notEmpty",

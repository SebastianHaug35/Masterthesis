    {
      "id": "9",
      "name": "Validate Business Data",
      "parameters": {
        "jsCode": "const request = $node['Prepare Happy Path Context'].json.request;\nconst input = $node['Prepare Happy Path Context'].json.input;\nconst po = $node['Fetch Purchase Order'].json;\nconst pr = $node['Fetch Purchase Receipt'].json;\nconst email = $node['Fetch Inbound Invoice Email'].json;\nconst pi = $node['Fetch Purchase Invoice'].json;\nconst errors = [];\nconst expectedSupplier = 'Meyer Industrietechnik GmbH';\nconst expectedPo = 'PO-4500012458';\nconst expectedReceipt = 'GR-2026-00441';\nconst expectedInvoice = 'INV-98451';\nif (!po || po.po_number !== expectedPo) errors.push('purchase_order_exists_in_erpnext');\nif (!pr || pr.receiving_report_id !== expectedReceipt || pr.po_number !== expectedPo) errors.push('purchase_receipt_exists_in_erpnext');\nif (!email || email.from !== 'vendor.billing@test.local') errors.push('invoice_email_exists_in_mailpit');\nif (!email || email.metadata?.vendor_name !== expectedSupplier) errors.push('vendor_name_matches_between_erpnext_and_invoice_email');\nif (!email || email.metadata?.po_number !== expectedPo) errors.push('po_number_matches_across_purchase_order_receipt_and_invoice_email');\nif (!email || Number(email.metadata?.gross_amount) !== Number(email.metadata?.net_amount) + Number(email.metadata?.tax_amount)) errors.push('gross_amount_equals_net_amount_plus_tax_amount');\nif (!pi || pi.bill_no !== expectedInvoice) errors.push('purchase_invoice_created_or_verified_in_erpnext');\nreturn [{ json: { request, input, po, pr, email, pi, validation_errors: errors, mock_base_url: request.mock_system_base_url || 'http://127.0.0.1:8088' } }];"
      },
      "position": [
        1340,
        220
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 2
    },

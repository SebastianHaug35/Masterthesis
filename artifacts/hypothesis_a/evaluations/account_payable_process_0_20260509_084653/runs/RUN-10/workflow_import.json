    {
      "id": "2",
      "name": "Validate Request",
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst errors = [];\nconst requiredTop = ['process_id','test_case_id','mock_system_base_url','input_payload'];\nfor (const k of requiredTop) {\n  if (body?.[k] === undefined || body?.[k] === null || body?.[k] === '') errors.push(`missing_${k}`);\n}\nconst input = body?.input_payload ?? {};\nfor (const k of ['case_id','invoice_number','mailpit_message_id','po_number','receiving_report_id']) {\n  if (!input[k]) errors.push(`missing_input_payload_${k}`);\n}\nreturn [{ json: { request: body, input, validation_errors: errors } }];"
      },
      "position": [
        460,
        300
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 2
    },
    {
      "id": "3",
      "name": "Request Valid?",
      "parameters": {
        "conditions": {

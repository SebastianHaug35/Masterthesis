      "parameters": {
        "jsCode": "const body = $json.body || {}; const input = body.input_payload || {}; const po = $node['Fetch Purchase Order'].json || {}; const pr = $node['Fetch Purchase Receipt'].json || {}; const email = $node['Fetch Inbound Invoice Email'].json || {}; const state = $node['Fetch Workflow State'].json || {}; const errors = []; if (!po || po.identifier !== input.po_number) errors.push('Purchase Order missing or mismatched'); if (!pr || pr.identifier !== input.receiving_report_id) errors.push('Purchase Receipt missing or mismatched'); if (!email || email.message_id !== input.mailpit_message_id) errors.push('Inbound invoice email missing or mismatched'); if (!email || email.from !== 'vendor.billing@test.local') errors.push('Vendor email sender mismatch'); if (!state || state.case_id !== input.case_id) errors.push('Workflow state missing or mismatched'); if (errors.length) { return [{ workflow_status: 'failed', validation_errors: errors }]; } return [{ case_id: input.case_id, po_number: input.po_number, receiving_report_id: input.receiving_report_id, invoice_number: input.invoice_number, mailpit_message_id: input.mailpit_message_id, supplier: 'Meyer Industrietechnik GmbH', vendor_id: 'V-10045', validation_ok: true }];"

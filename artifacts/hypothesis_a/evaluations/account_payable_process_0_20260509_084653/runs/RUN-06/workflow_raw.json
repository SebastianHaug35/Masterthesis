      "name": "Validate Request",
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst errors = [];\nconst required = ['process_id','test_case_id','mock_system_base_url','input_payload'];\nfor (const key of required) {\n  if (!(key in body)) errors.push(`Missing required field: ${key}`);\n}\nconst input = body.input_payload ?? {};\nfor (const key of ['case_id','invoice_number','mailpit_message_id','po_number','receiving_report_id']) {\n  if (!(key in input) || input[key] === '') errors.push(`Missing required input_payload field: ${key}`);\n}\nif (body.process_id !== 'account_payable_process_0') errors.push('process_id must be account_payable_process_0');\nif (errors.length) {\n  return [{ json: { workflow_status: 'failed', validation_errors: errors } }];\n}\nreturn [{\n  json: {\n    process_id: body.process_id,\n    test_case_id: body.test_case_id,\n    mock_system_base_url: body.mock_system_base_url || 'http://127.0.0.1:8088',\n    case_id: input.case_id,\n    invoice_number: input.invoice_number,\n    mailpit_message_id: input.mailpit_message_id,\n    po_number: input.po_number,\n    receiving_report_id: input.receiving_report_id,\n    workflow_status: 'running'\n  }\n}];"

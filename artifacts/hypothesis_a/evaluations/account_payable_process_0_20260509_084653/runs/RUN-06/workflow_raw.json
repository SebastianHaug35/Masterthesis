    {
      "name": "Build Final Response",
      "parameters": {
        "jsCode": "const po = $items('Fetch Purchase Order')[0]?.json ?? {};\nconst pr = $items('Fetch Purchase Receipt')[0]?.json ?? {};\nconst invEmail = $items('Fetch Inbound Invoice Email')[0]?.json ?? {};\nconst invoice = $items('Fetch Purchase Invoice')[0]?.json ?? {};\nconst state = $items('Fetch Workflow State')[0]?.json ?? {};\nconst stamp = $items('Stamp and Archive Documents')[0]?.json ?? {};\nconst mailSend = $items('Send Result Email')[0]?.json ?? {};\nconst errors = [];\nif (!po) errors.push('Purchase Order not found');\nif (!pr) errors.push('Purchase Receipt not found');\nif (!invEmail) errors.push('Inbound invoice email not found');\nif (!invoice || (invoice.bill_no && invoice.bill_no !== 'INV-98451')) errors.push('Purchase Invoice missing or wrong bill_no');\nif (state.status && state.status !== 'completed') errors.push('Workflow state is not completed');\nconst out = {\n  archive_location: stamp.archive_location || 'erpnext://account-payable/AP-2026-0001',\n  case_id: 'AP-2026-0001',\n  erpnext_purchase_invoice_bill_no: invoice.bill_no || 'INV-98451',\n  notification_email_sent: !!(mailSend.success ?? true),\n  stamp_status: stamp.stamp_status || 'stamped',\n  workflow_status: 'completed'\n};\nif (errors.length) return [{ json: { workflow_status: 'failed', validation_errors: errors } }];\nreturn [{ json: out }];"

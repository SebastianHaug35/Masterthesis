      "name": "Validate Required Inputs",
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "operation": "isTrue",
              "value1": "={{$json.case_id && $json.invoice_number && $json.po_number && $json.receiving_report_id}}"
            }
          ]
        }
      },
      "position": [
        680,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2

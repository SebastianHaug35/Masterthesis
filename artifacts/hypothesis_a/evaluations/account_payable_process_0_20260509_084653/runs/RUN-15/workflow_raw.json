          "string": [
            {
              "name": "workflow_status",
              "value": "failed"
            },
            {
              "name": "validation_errors",
              "value": "={{JSON.stringify([(! $json.case_id ? 'Missing case_id' : null), (! $json.invoice_number ? 'Missing invoice_number' : null), (! $json.po_number ? 'Missing po_number' : null), (! $json.receiving_report_id ? 'Missing receiving_report_id' : null)].filter(Boolean))}}"
            }
          ]
        }
      },
      "position": [
        900,
        500
      ],

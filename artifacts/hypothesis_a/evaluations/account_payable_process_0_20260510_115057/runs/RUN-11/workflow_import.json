      "name": "Validate Input",
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst errors = [];\nconst required = ['process_id','test_case_id','mock_system_base_url','input_payload'];\nfor (const key of required) { if (body[key] === undefined || body[key] === null || body[key] === '') errors.push(`missing_${key}`); }\nconst ip = body.input_payload || {};\nfor (const key of ['case_id','invoice_number','mailpit_message_id','po_number','receiving_report_id']) { if (!ip[key]) errors.push(`missing_input_payload_${key}`); }\nif (body.process_id && body.process_id !== 'account_payable_process_0') errors.push('invalid_process_id');\nreturn [{ json: { ...body, validation_errors: errors, workflow_status: errors.length ? 'failed' : 'validated' } }];"
      },
      "position": [
        460,
        300
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 2
    },

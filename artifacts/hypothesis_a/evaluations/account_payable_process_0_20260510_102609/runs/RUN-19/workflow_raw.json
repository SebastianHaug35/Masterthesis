    {
      "name": "Verify ERPNext and Mailpit",
      "parameters": {
        "jsCode": "const req = $node['Validate Request'].json.request;\nconst invoice = $node['Get Purchase Invoice'].json;\nconst mail = $node['Get Mailpit Messages'].json;\nconst errors = [];\nconst items = invoice.data || invoice.message || invoice.data?.data || [];\nconst foundInvoice = Array.isArray(items) ? items.find(i => i.bill_no === req.input_payload.invoice_number) : null;\nif (!foundInvoice) errors.push(`Purchase Invoice with bill_no ${req.input_payload.invoice_number} not found`);\nconst msgs = mail.data || mail.messages || mail.items || [];\nconst outbound = Array.isArray(msgs) ? msgs.find(m => {\n  const subj = (m.subject || '').toString();\n  const from = (m.from || '').toString();\n  const to = (m.to || '').toString();\n  const body = (m.text || m.body || m.preview || '').toString();\n  return from.includes('noreply@test.local') && to.includes('accounting@test.local') && subj.includes(req.input_payload.case_id) && subj.includes('completed') && body.includes(req.input_payload.po_number) && body.includes(req.input_payload.receiving_report_id) && body.includes(req.input_payload.invoice_number) && body.includes('stamped');\n}) : null;\nif (!outbound) errors.push('Outbound accounting notification email not found or incomplete');\nreturn [{ json: { ok: errors.length === 0, validation_errors: errors, request: req, found_invoice: foundInvoice ? true : false, notification_email_sent: !!outbound } }];"
      },

    {
      "name": "Validate Request",
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst errors = [];\nif (body.process_id !== 'account_payable_process_0') errors.push('process_id must equal account_payable_process_0');\nif (body.test_case_id !== 'account_payable_process_0_erpnext_mailpit_happy_path') errors.push('test_case_id must equal account_payable_process_0_erpnext_mailpit_happy_path');\nif (!body.input_payload || typeof body.input_payload !== 'object') errors.push('input_payload is required');\nconst p = body.input_payload || {};\nfor (const f of ['case_id','invoice_number','mailpit_message_id','po_number','receiving_report_id']) {\n  if (!p[f]) errors.push(`input_payload.${f} is required`);\n}\nreturn [{ json: { valid: errors.length === 0, validation_errors: errors, request: body } }];"
      },
      "position": [
        460,
        300
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 2
    },

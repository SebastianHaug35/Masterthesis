            },
            {
              "name": "caseId",
              "value": "={{$json.body.input_payload.case_id || ''}}"
            },
            {
              "name": "poNumber",
              "value": "={{$json.body.input_payload.po_number || ''}}"
            },
            {
              "name": "receivingReportId",
              "value": "={{$json.body.input_payload.receiving_report_id || ''}}"
            },
            {
              "name": "validationErrors",
              "value": "=[]"

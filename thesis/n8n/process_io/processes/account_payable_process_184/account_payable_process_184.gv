		"AND_SPLIT--3. Document validation_T5O4" [label="+" fixedsize=true shape=diamond width=0.5]
		"create a receiving report" -> "AND_SPLIT--3. Document validation_T5O4"
		"report errors to relevant team member" [shape=box]
		"AND_SPLIT--3. Document validation_T5O4" -> "report errors to relevant team member"

	subgraph CLUSTER_0 {
		"send to the senior accountant in your department" [shape=box]
		"create a receiving report" [shape=box]
		"send to the senior accountant in your department" -> "create a receiving report"
		"AND_SPLIT--3. Document validation_34OW" [label="+" fixedsize=true shape=diamond width=0.5]
		"create a receiving report" -> "AND_SPLIT--3. Document validation_34OW"
		"report errors to relevant team member" [shape=box]
		"AND_SPLIT--3. Document validation_34OW" -> "report errors to relevant team member"
		"gather the vendors invoice" [shape=box]
		"AND_SPLIT--3. Document validation_34OW" -> "gather the vendors invoice"
		"AND_JOIN--3. Document validation_34OW" [label="+" fixedsize=true shape=diamond width=0.5]
		"report errors to relevant team member" -> "AND_JOIN--3. Document validation_34OW"
		"gather the vendors invoice" -> "AND_JOIN--3. Document validation_34OW"
		"OR_SPLIT--4. Payment_VETO" [label=O fixedsize=true shape=diamond width=0.5]
		"AND_JOIN--3. Document validation_34OW" -> "OR_SPLIT--4. Payment_VETO"
		"store in paid invoice file" [shape=box]
		"OR_SPLIT--4. Payment_VETO" -> "store in paid invoice file"
		"check dates to avoid penalty charges" [shape=box]
		"OR_SPLIT--4. Payment_VETO" -> "check dates to avoid penalty charges"
		"OR_JOIN--4. Payment_VETO" [label=O fixedsize=true shape=diamond width=0.5]
		"store in paid invoice file" -> "OR_JOIN--4. Payment_VETO"
		"check dates to avoid penalty charges" -> "OR_JOIN--4. Payment_VETO"

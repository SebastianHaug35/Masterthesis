		"OR_SPLIT--3. Document validation_WF3S" -> "confirm all documents have been amended"
		"double check a three-way match" [shape=box]
		"OR_SPLIT--3. Document validation_WF3S" -> "double check a three-way match"
		"OR_JOIN--3. Document validation_WF3S" [label=O fixedsize=true shape=diamond width=0.5]

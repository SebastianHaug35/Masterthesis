digraph account_payable_process_21 {
	graph [rankdir=LR]
	START_NODE [label="" shape=circle width=0.3]
	subgraph CLUSTER_0 {
		"send to the receiving department" [shape=box]
		"create a receiving report" [shape=box]
		"send to the receiving department" -> "create a receiving report"
		"confirm all documents have been amended" [shape=box]
		"create a receiving report" -> "confirm all documents have been amended"
		"AND_SPLIT--4. Payment_9OJQ" [label="+" fixedsize=true shape=diamond width=0.5]
		"confirm all documents have been amended" -> "AND_SPLIT--4. Payment_9OJQ"
		"create voucher for the documents" [shape=box]
		"AND_SPLIT--4. Payment_9OJQ" -> "create voucher for the documents"
		"enter the invoice into the accounts payable account" [shape=box]
		"AND_SPLIT--4. Payment_9OJQ" -> "enter the invoice into the accounts payable account"
		"check dates to avoid penalty charges" [shape=box]
		"create voucher for the documents" -> "check dates to avoid penalty charges"
		"OR_SPLIT--4. Payment_HYRC" [label=O fixedsize=true shape=diamond width=0.5]
		"enter the invoice into the accounts payable account" -> "OR_SPLIT--4. Payment_HYRC"
		"store in paid invoice file" [shape=box]
		"OR_SPLIT--4. Payment_HYRC" -> "store in paid invoice file"
		"stamp all documents" [shape=box]
		"OR_SPLIT--4. Payment_HYRC" -> "stamp all documents"
		"schedule the payment" [shape=box]
		"OR_SPLIT--4. Payment_HYRC" -> "schedule the payment"
		"OR_JOIN--4. Payment_HYRC" [label=O fixedsize=true shape=diamond width=0.5]
		"store in paid invoice file" -> "OR_JOIN--4. Payment_HYRC"
		"stamp all documents" -> "OR_JOIN--4. Payment_HYRC"
		"schedule the payment" -> "OR_JOIN--4. Payment_HYRC"
		"AND_JOIN--4. Payment_9OJQ" [label="+" fixedsize=true shape=diamond width=0.5]

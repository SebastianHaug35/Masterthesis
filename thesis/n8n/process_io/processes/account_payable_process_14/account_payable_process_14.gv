		"OR_SPLIT--3. Document validation_W58D" [label=O fixedsize=true shape=diamond width=0.5]
		"create a receiving report" -> "OR_SPLIT--3. Document validation_W58D"
		"gather the receiving report" [shape=box]
		"OR_SPLIT--3. Document validation_W58D" -> "gather the receiving report"
		"gather the vendors invoice" [shape=box]
		"OR_SPLIT--3. Document validation_W58D" -> "gather the vendors invoice"
		"report errors to relevant team member" [shape=box]
		"OR_SPLIT--3. Document validation_W58D" -> "report errors to relevant team member"
		"OR_SPLIT--3. Document validation_RGJR" [label=O fixedsize=true shape=diamond width=0.5]
		"gather the receiving report" -> "OR_SPLIT--3. Document validation_RGJR"
		"double check a three-way match" [shape=box]
		"OR_SPLIT--3. Document validation_RGJR" -> "double check a three-way match"
		"confirm all documents have been amended" [shape=box]
		"OR_SPLIT--3. Document validation_RGJR" -> "confirm all documents have been amended"
		"OR_JOIN--3. Document validation_RGJR" [label=O fixedsize=true shape=diamond width=0.5]
		"double check a three-way match" -> "OR_JOIN--3. Document validation_RGJR"
		"confirm all documents have been amended" -> "OR_JOIN--3. Document validation_RGJR"
		"OR_JOIN--3. Document validation_W58D" [label=O fixedsize=true shape=diamond width=0.5]
		"OR_JOIN--3. Document validation_RGJR" -> "OR_JOIN--3. Document validation_W58D"
		"gather the vendors invoice" -> "OR_JOIN--3. Document validation_W58D"
		"report errors to relevant team member" -> "OR_JOIN--3. Document validation_W58D"

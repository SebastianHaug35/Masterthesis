	subgraph CLUSTER_0 {
		"enter purchase order details" [shape=box]
		"create a receiving report" [shape=box]
		"enter purchase order details" -> "create a receiving report"
		"gather the receiving report" [shape=box]
		"create a receiving report" -> "gather the receiving report"
		"AND_SPLIT--4. Payment_IBG5" [label="+" fixedsize=true shape=diamond width=0.5]
		"gather the receiving report" -> "AND_SPLIT--4. Payment_IBG5"
		"check dates to avoid penalty charges" [shape=box]
		"AND_SPLIT--4. Payment_IBG5" -> "check dates to avoid penalty charges"
		"enter the invoice into the accounts payable account" [shape=box]
		"AND_SPLIT--4. Payment_IBG5" -> "enter the invoice into the accounts payable account"
		"create voucher for the documents" [shape=box]
		"check dates to avoid penalty charges" -> "create voucher for the documents"
		"AND_JOIN--4. Payment_IBG5" [label="+" fixedsize=true shape=diamond width=0.5]

		"create a receiving report" [shape=box]
		"send to the receiving department" -> "create a receiving report"
		"AND_SPLIT--3. Document validation_29T6" [label="+" fixedsize=true shape=diamond width=0.5]
		"create a receiving report" -> "AND_SPLIT--3. Document validation_29T6"
		"gather the receiving report" [shape=box]
		"AND_SPLIT--3. Document validation_29T6" -> "gather the receiving report"

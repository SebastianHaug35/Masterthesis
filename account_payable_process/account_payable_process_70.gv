		"AND_SPLIT--3. Document validation_29T6" -> "confirm all documents have been amended"
		"report errors to relevant team member" [shape=box]
		"gather the receiving report" -> "report errors to relevant team member"
		"AND_JOIN--3. Document validation_29T6" [label="+" fixedsize=true shape=diamond width=0.5]
		"report errors to relevant team member" -> "AND_JOIN--3. Document validation_29T6"
		"confirm all documents have been amended" -> "AND_JOIN--3. Document validation_29T6"
		"OR_SPLIT--4. Payment_NYCP" [label=O fixedsize=true shape=diamond width=0.5]
		"AND_JOIN--3. Document validation_29T6" -> "OR_SPLIT--4. Payment_NYCP"
		"create voucher for the documents" [shape=box]
		"OR_SPLIT--4. Payment_NYCP" -> "create voucher for the documents"

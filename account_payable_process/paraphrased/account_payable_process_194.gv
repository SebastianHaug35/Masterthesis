		"double check a three-way match" [shape=box]
		"create a receiving report" -> "double check a three-way match"
		"AND_SPLIT--4. Payment_LM1J" [label="+" fixedsize=true shape=diamond width=0.5]
		"double check a three-way match" -> "AND_SPLIT--4. Payment_LM1J"
		"schedule the payment" [shape=box]
		"AND_SPLIT--4. Payment_LM1J" -> "schedule the payment"
		"create voucher for the documents" [shape=box]

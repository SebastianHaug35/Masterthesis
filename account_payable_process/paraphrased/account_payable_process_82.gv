		"AND_SPLIT--4. Payment_G8AF" [label="+" fixedsize=true shape=diamond width=0.5]
		"confirm all documents have been amended" -> "AND_SPLIT--4. Payment_G8AF"
		"schedule the payment" [shape=box]
		"AND_SPLIT--4. Payment_G8AF" -> "schedule the payment"
		"stamp all documents" [shape=box]
		"AND_SPLIT--4. Payment_G8AF" -> "stamp all documents"
		"enter the invoice into the accounts payable account" [shape=box]
		"AND_SPLIT--4. Payment_G8AF" -> "enter the invoice into the accounts payable account"
		"check dates to avoid penalty charges" [shape=box]
		"schedule the payment" -> "check dates to avoid penalty charges"
		"create voucher for the documents" [shape=box]
		"stamp all documents" -> "create voucher for the documents"
		"AND_JOIN--4. Payment_G8AF" [label="+" fixedsize=true shape=diamond width=0.5]

		"OR_SPLIT--3. Document validation_SR7Y" -> "report errors to relevant team member"
		"AND_SPLIT--3. Document validation_HNK3" [label="+" fixedsize=true shape=diamond width=0.5]
		"report errors to relevant team member" -> "AND_SPLIT--3. Document validation_HNK3"
		"gather the receiving report" [shape=box]

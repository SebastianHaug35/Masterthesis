		"confirm all documents have been amended" [shape=box]
		"AND_SPLIT--3. Document validation_HNK3" -> "confirm all documents have been amended"
		"AND_JOIN--3. Document validation_HNK3" [label="+" fixedsize=true shape=diamond width=0.5]
		"gather the receiving report" -> "AND_JOIN--3. Document validation_HNK3"
		"confirm all documents have been amended" -> "AND_JOIN--3. Document validation_HNK3"
		"OR_JOIN--3. Document validation_SR7Y" [label=O fixedsize=true shape=diamond width=0.5]

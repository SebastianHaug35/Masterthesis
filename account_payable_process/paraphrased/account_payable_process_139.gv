		"OR_SPLIT--3. Document validation_NMT9" -> "report errors to relevant team member"
		"gather the vendors invoice" [shape=box]
		"OR_SPLIT--3. Document validation_NMT9" -> "gather the vendors invoice"
		"OR_JOIN--3. Document validation_NMT9" [label=O fixedsize=true shape=diamond width=0.5]

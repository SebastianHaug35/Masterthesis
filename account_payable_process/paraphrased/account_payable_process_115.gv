		"AND_SPLIT--4. Payment_X0F3" [label="+" fixedsize=true shape=diamond width=0.5]
		"gather the receiving report" -> "AND_SPLIT--4. Payment_X0F3"
		"store in paid invoice file" [shape=box]
		"AND_SPLIT--4. Payment_X0F3" -> "store in paid invoice file"
		"stamp all documents" [shape=box]
		"AND_SPLIT--4. Payment_X0F3" -> "stamp all documents"
		"AND_SPLIT--4. Payment_O3OY" [label="+" fixedsize=true shape=diamond width=0.5]
		"store in paid invoice file" -> "AND_SPLIT--4. Payment_O3OY"
		"enter the invoice into the accounts payable account" [shape=box]
		"AND_SPLIT--4. Payment_O3OY" -> "enter the invoice into the accounts payable account"
		"schedule the payment" [shape=box]
		"AND_SPLIT--4. Payment_O3OY" -> "schedule the payment"
		"AND_JOIN--4. Payment_O3OY" [label="+" fixedsize=true shape=diamond width=0.5]

digraph account_payable_process_87 {
	graph [rankdir=LR]
	START_NODE [label="" shape=circle width=0.3]
	subgraph CLUSTER_0 {
		"send to the senior accountant in your department" [shape=box]
		"create a receiving report" [shape=box]
		"send to the senior accountant in your department" -> "create a receiving report"
		"AND_SPLIT--3. Document validation_QE9R" [label="+" fixedsize=true shape=diamond width=0.5]
		"create a receiving report" -> "AND_SPLIT--3. Document validation_QE9R"
		"double check a three-way match" [shape=box]
		"AND_SPLIT--3. Document validation_QE9R" -> "double check a three-way match"
		"gather the receiving report" [shape=box]
		"AND_SPLIT--3. Document validation_QE9R" -> "gather the receiving report"
		"AND_SPLIT--3. Document validation_XI0T" [label="+" fixedsize=true shape=diamond width=0.5]
		"double check a three-way match" -> "AND_SPLIT--3. Document validation_XI0T"
		"report errors to relevant team member" [shape=box]
		"AND_SPLIT--3. Document validation_XI0T" -> "report errors to relevant team member"
		"gather the vendors invoice" [shape=box]
		"AND_SPLIT--3. Document validation_XI0T" -> "gather the vendors invoice"
		"confirm all documents have been amended" [shape=box]
		"gather the vendors invoice" -> "confirm all documents have been amended"
		"AND_JOIN--3. Document validation_XI0T" [label="+" fixedsize=true shape=diamond width=0.5]
		"report errors to relevant team member" -> "AND_JOIN--3. Document validation_XI0T"
		"confirm all documents have been amended" -> "AND_JOIN--3. Document validation_XI0T"
		"AND_JOIN--3. Document validation_QE9R" [label="+" fixedsize=true shape=diamond width=0.5]
		"AND_JOIN--3. Document validation_XI0T" -> "AND_JOIN--3. Document validation_QE9R"
		"gather the receiving report" -> "AND_JOIN--3. Document validation_QE9R"

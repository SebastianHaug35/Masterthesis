		"AND_JOIN--3. Document validation_Z4I4" [label="+" fixedsize=true shape=diamond width=0.5]
		"double check a three-way match" -> "AND_JOIN--3. Document validation_Z4I4"
		"confirm all documents have been amended" -> "AND_JOIN--3. Document validation_Z4I4"

digraph account_payable_process_30 {
	graph [rankdir=LR]
	START_NODE [label="" shape=circle width=0.3]
	subgraph CLUSTER_0 {
		"file a copy for internal records" [shape=box]
		"create a receiving report" [shape=box]
		"file a copy for internal records" -> "create a receiving report"
		"AND_SPLIT--3. Document validation_X5IL" [label="+" fixedsize=true shape=diamond width=0.5]
		"create a receiving report" -> "AND_SPLIT--3. Document validation_X5IL"
		"double check a three-way match" [shape=box]
		"AND_SPLIT--3. Document validation_X5IL" -> "double check a three-way match"
		"confirm all documents have been amended" [shape=box]
		"AND_SPLIT--3. Document validation_X5IL" -> "confirm all documents have been amended"
		"AND_JOIN--3. Document validation_X5IL" [label="+" fixedsize=true shape=diamond width=0.5]

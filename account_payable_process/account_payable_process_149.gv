		"gather the receiving report" [shape=box]
		"create a receiving report" -> "gather the receiving report"
		"OR_SPLIT--4. Payment_84E3" [label=O fixedsize=true shape=diamond width=0.5]
		"gather the receiving report" -> "OR_SPLIT--4. Payment_84E3"
		"schedule the payment" [shape=box]
		"OR_SPLIT--4. Payment_84E3" -> "schedule the payment"

		"AND_SPLIT--3. Document validation_J2QH" -> "double check a three-way match"
		"confirm all documents have been amended" [shape=box]
		"double check a three-way match" -> "confirm all documents have been amended"
		"AND_JOIN--3. Document validation_J2QH" [label="+" fixedsize=true shape=diamond width=0.5]

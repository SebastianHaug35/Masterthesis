		"send to the receiving department" -> "create a receiving report"
		"AND_SPLIT--3. Document validation_J2QH" [label="+" fixedsize=true shape=diamond width=0.5]
		"create a receiving report" -> "AND_SPLIT--3. Document validation_J2QH"
		"gather the vendors invoice" [shape=box]
		"AND_SPLIT--3. Document validation_J2QH" -> "gather the vendors invoice"

digraph account_payable_process_145 {
	graph [rankdir=LR]
	START_NODE [label="" shape=circle width=0.3]
	subgraph CLUSTER_0 {
		"send to the senior accountant in your department" [shape=box]
		"create a receiving report" [shape=box]
		"send to the senior accountant in your department" -> "create a receiving report"
		"report errors to relevant team member" [shape=box]
		"create a receiving report" -> "report errors to relevant team member"
		"OR_SPLIT--4. Payment_L4GA" [label=O fixedsize=true shape=diamond width=0.5]
		"report errors to relevant team member" -> "OR_SPLIT--4. Payment_L4GA"
		"stamp all documents" [shape=box]
		"OR_SPLIT--4. Payment_L4GA" -> "stamp all documents"
		"check dates to avoid penalty charges" [shape=box]
		"OR_SPLIT--4. Payment_L4GA" -> "check dates to avoid penalty charges"
		"OR_JOIN--4. Payment_L4GA" [label=O fixedsize=true shape=diamond width=0.5]

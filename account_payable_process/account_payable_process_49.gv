		"OR_SPLIT--4. Payment_AZB4" -> "enter the invoice into the accounts payable account"
		"stamp all documents" [shape=box]
		"OR_SPLIT--4. Payment_AZB4" -> "stamp all documents"
		"check dates to avoid penalty charges" [shape=box]
		"OR_SPLIT--4. Payment_AZB4" -> "check dates to avoid penalty charges"
		"OR_JOIN--4. Payment_AZB4" [label=O fixedsize=true shape=diamond width=0.5]
		"enter the invoice into the accounts payable account" -> "OR_JOIN--4. Payment_AZB4"

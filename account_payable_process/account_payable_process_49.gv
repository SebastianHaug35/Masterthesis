		"gather the vendors invoice" -> "AND_JOIN--3. Document validation_M6R4"
		"OR_SPLIT--4. Payment_AZB4" [label=O fixedsize=true shape=diamond width=0.5]
		"AND_JOIN--3. Document validation_M6R4" -> "OR_SPLIT--4. Payment_AZB4"

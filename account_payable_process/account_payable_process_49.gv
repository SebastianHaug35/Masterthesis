		"AND_SPLIT--3. Document validation_M6R4" -> "report errors to relevant team member"
		"gather the vendors invoice" [shape=box]
		"report errors to relevant team member" -> "gather the vendors invoice"
		"AND_JOIN--3. Document validation_M6R4" [label="+" fixedsize=true shape=diamond width=0.5]

digraph account_payable_process_93 {
	graph [rankdir=LR]
	START_NODE [label="" shape=circle width=0.3]
	subgraph CLUSTER_0 {
		"send to the senior accountant in your department" [shape=box]
		"create a receiving report" [shape=box]
		"send to the senior accountant in your department" -> "create a receiving report"
		"AND_SPLIT--3. Document validation_TCQ1" [label="+" fixedsize=true shape=diamond width=0.5]
		"create a receiving report" -> "AND_SPLIT--3. Document validation_TCQ1"
		"gather the receiving report" [shape=box]
		"AND_SPLIT--3. Document validation_TCQ1" -> "gather the receiving report"
		"double check a three-way match" [shape=box]
		"AND_SPLIT--3. Document validation_TCQ1" -> "double check a three-way match"
		"AND_JOIN--3. Document validation_TCQ1" [label="+" fixedsize=true shape=diamond width=0.5]
		"gather the receiving report" -> "AND_JOIN--3. Document validation_TCQ1"
		"double check a three-way match" -> "AND_JOIN--3. Document validation_TCQ1"
		"AND_SPLIT--4. Payment_1BVE" [label="+" fixedsize=true shape=diamond width=0.5]
		"AND_JOIN--3. Document validation_TCQ1" -> "AND_SPLIT--4. Payment_1BVE"
		"stamp all documents" [shape=box]
		"AND_SPLIT--4. Payment_1BVE" -> "stamp all documents"
		"schedule the payment" [shape=box]
		"AND_SPLIT--4. Payment_1BVE" -> "schedule the payment"
		"create voucher for the documents" [shape=box]
		"AND_SPLIT--4. Payment_1BVE" -> "create voucher for the documents"
		"enter the invoice into the accounts payable account" [shape=box]
		"schedule the payment" -> "enter the invoice into the accounts payable account"
		"AND_JOIN--4. Payment_1BVE" [label="+" fixedsize=true shape=diamond width=0.5]
		"stamp all documents" -> "AND_JOIN--4. Payment_1BVE"
		"enter the invoice into the accounts payable account" -> "AND_JOIN--4. Payment_1BVE"

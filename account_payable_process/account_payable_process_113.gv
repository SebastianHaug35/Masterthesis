		"create a receiving report" [shape=box]
		"send to the receiving department" -> "create a receiving report"
		"gather the receiving report" [shape=box]
		"create a receiving report" -> "gather the receiving report"
		"OR_SPLIT--4. Payment_TLDJ" [label=O fixedsize=true shape=diamond width=0.5]
		"gather the receiving report" -> "OR_SPLIT--4. Payment_TLDJ"
		"schedule the payment" [shape=box]
		"OR_SPLIT--4. Payment_TLDJ" -> "schedule the payment"
		"store in paid invoice file" [shape=box]

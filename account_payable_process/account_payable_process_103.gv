		"double check a three-way match" [shape=box]
		"create a receiving report" -> "double check a three-way match"
		"AND_SPLIT--4. Payment_ATZ7" [label="+" fixedsize=true shape=diamond width=0.5]
		"double check a three-way match" -> "AND_SPLIT--4. Payment_ATZ7"
